# Copy to .env for local development (never commit .env).

# PostgreSQL (matches docker-compose.dev.yml)
DATABASE_URL=postgres://newlms:newlms@localhost:5433/newlms

# Better Auth — generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Separate origin for SCORM content and player. It must be a different host from the app
# (in production e.g. https://scorm.example.com, pointing to the same container).
SCORM_ORIGIN=http://scorm.localhost:3000

# Storage directory for files, videos and extracted SCORM packages (not served directly)
FILES_DIR=./data/files

# Upload limits in MB
MAX_FILE_UPLOAD_MB=100
MAX_SCORM_UPLOAD_MB=500
MAX_SCORM_EXTRACTED_MB=2000
MAX_VIDEO_UPLOAD_MB=1024

# First admin, used only by `pnpm seed:admin`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Development users (docente@newlms.test, studente@newlms.test), used only by `pnpm seed:dev`
SEED_DEV_PASSWORD=
